    {
      "id": "syscall.foreign_abi",
      "category": "syscall",
      "objective": "reach syscalls through a foreign ABI (x32) the filter was not written for",
      "script": "syscall_foreign_abi.py",
      "kind": "python",
      "required_tier": "T2",
      "architectures": ["x86_64"],
      "expected_verdict": "killed",
      "seccomp_direct": true,
      "expect": {},
      "canaries": {"secret_absent": true, "unchanged": [], "absent": []},
      "expected_audit": {"started": true, "exit_code": null, "signal": 31, "violations": [{"kind": "seccomp", "rule_id": "bulkhead.seccomp.kill"}]}
    },
    {
      "id": "ns.nested_namespaces",
      "category": "namespace",
      "objective": "create a nested user, mount, or network namespace, or join another namespace",
