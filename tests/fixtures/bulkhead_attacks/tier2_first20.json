{
  "schema_version": 1,
  "phase": "bwrap-namespace-phase",
  "required_tier": "T2",
  "description": "The first 20 tier-2 attacks: filesystem view, cross-process access, blocked syscall classes, nested namespaces, sockets, privilege, and environment. Each attack's objective must fail. 'expect' lists the outcomes each attempt may have; 'canaries' are checked on the host; 'seccomp_direct' attacks also run under the seccomp filter alone (no namespaces), which tests the filter by itself.",
  "workspace_files": {
    ".env": "secret",
    ".git/config": "secret",
    ".git/hooks/README": "sample hook directory\n",
    "README.txt": "hello from the workspace\n"
  },
  "attacks": [
    {
      "id": "fs.read_fake_ssh_key",
      "category": "filesystem",
      "objective": "read a fake SSH private key in a host home directory",
      "script": "fs_read_fake_ssh_key.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"host_home_key": ["ENOENT"], "home_relative_key": ["ENOENT"], "root_key": ["ENOENT"], "list_home": ["ENOENT"]},
      "canaries": {"secret_absent": true, "unchanged": ["canary:home/.ssh/id_rsa"], "absent": []},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "fs.read_shadow_like",
      "category": "filesystem",
      "objective": "read /etc/shadow, /etc/passwd, or a shadow-like host canary",
      "script": "fs_read_shadow_like.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"etc_shadow": ["ENOENT"], "etc_passwd": ["ENOENT"], "shadow_canary": ["ENOENT"]},
      "canaries": {"secret_absent": true, "unchanged": ["canary:shadow"], "absent": []},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "fs.write_outside_absolute",
      "category": "filesystem",
      "objective": "write a host file outside the workspace by absolute path, or the read-only workspace root",
      "script": "fs_write_outside_absolute.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"host_victim": ["ENOENT"], "host_new_file": ["ENOENT"], "usr": ["EROFS", "EACCES"], "workspace_root": ["EROFS", "EACCES"]},
      "canaries": {"secret_absent": true, "unchanged": ["canary:victim.txt"], "absent": ["canary:created-by-attack", "workspace:created-by-attack"]},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "fs.write_dotdot",
      "category": "filesystem",
      "objective": "escape the writable directory with .. components",
      "script": "fs_write_dotdot.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"dotdot_victim": ["ENOENT"], "dotdot_workspace": ["EROFS", "EACCES"], "chdir_dotdot_victim": ["ENOENT"]},
      "canaries": {"secret_absent": true, "unchanged": ["canary:victim.txt"], "absent": ["workspace:escaped.txt"]},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "fs.symlink_escape",
      "category": "filesystem",
      "objective": "read or write a host canary through a symlink created in the writable directory",
      "script": "fs_symlink_escape.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"symlink_create": ["ok"], "write_through_symlink": ["ENOENT"], "read_through_symlink": ["ENOENT"], "symlink_to_ssh": ["ok"], "read_ssh_through_symlink": ["ENOENT"]},
      "canaries": {"secret_absent": true, "unchanged": ["canary:victim.txt", "canary:home/.ssh/id_rsa"], "absent": []},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "fs.hardlink_escape",
      "category": "filesystem",
      "objective": "hardlink a host or read-only file into the writable directory and modify it",
      "script": "fs_hardlink_escape.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"link_host_victim": ["ENOENT"], "link_readonly_workspace_file": ["EXDEV", "EPERM"], "link_runtime_file": ["EXDEV", "EPERM"]},
      "canaries": {"secret_absent": true, "unchanged": ["canary:victim.txt", "workspace:README.txt"], "absent": []},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "fs.read_env",
      "category": "filesystem",
      "objective": "read the denied workspace .env file",
      "script": "fs_read_env.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"read_env": ["EACCES"], "stat_env": ["ok", "EACCES"]},
      "canaries": {"secret_absent": true, "unchanged": ["workspace:.env"], "absent": []},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "fs.write_env",
      "category": "filesystem",
      "objective": "overwrite, append to, delete, or move the denied workspace .env file",
      "script": "fs_write_env.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"overwrite_env": ["EACCES", "EROFS"], "append_env": ["EACCES", "EROFS"], "unlink_env": ["EROFS", "EBUSY", "EACCES", "EPERM"], "rename_env": ["EROFS", "EBUSY", "EXDEV", "EACCES", "EPERM"]},
      "canaries": {"secret_absent": true, "unchanged": ["workspace:.env"], "absent": ["workspace:out/env"]},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "fs.read_git",
      "category": "filesystem",
      "objective": "list or read the denied workspace .git directory",
      "script": "fs_read_git.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"list_git": ["EACCES"], "read_git_config": ["EACCES"], "list_hooks": ["EACCES"]},
      "canaries": {"secret_absent": true, "unchanged": ["workspace:.git/config"], "absent": []},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "fs.write_git_hooks",
      "category": "filesystem",
      "objective": "plant a git hook or redirect hooksPath in the denied .git directory",
      "script": "fs_write_git_hooks.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"write_pre_commit": ["EACCES"], "chmod_pre_commit": ["EACCES", "ENOENT"], "write_git_config": ["EACCES"], "replace_git_dir": ["EROFS", "EBUSY", "EXDEV", "EACCES", "EPERM"]},
      "canaries": {"secret_absent": true, "unchanged": ["workspace:.git/config", "workspace:.git/hooks/README"], "absent": ["workspace:.git/hooks/pre-commit", "workspace:out/git"]},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "proc.cross_process",
      "category": "process",
      "objective": "trace or read another process's memory, or steal its descriptors",
      "script": "proc_cross_process.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": true,
      "expect": {"ptrace_traceme": ["EPERM"], "ptrace_attach_parent": ["EPERM"], "process_vm_readv_self": ["EPERM"], "process_vm_readv_parent": ["EPERM"], "process_vm_writev_self": ["EPERM"], "pidfd_getfd_self": ["EPERM"]},
      "canaries": {"secret_absent": true, "unchanged": [], "absent": []},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "proc.helper_inspection",
      "category": "process",
      "objective": "read the sandbox helper's memory or environment, or see host processes",
      "script": "proc_helper_inspection.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": false,
      "expect": {"proc_1_mem": ["EACCES", "EPERM", "EIO"], "proc_1_environ": ["ok", "EACCES", "EPERM"], "proc_parent_environ": ["ok", "EACCES", "EPERM"], "host_supervisor_cmdline": ["ENOENT"]},
      "canaries": {"secret_absent": true, "unchanged": [], "absent": []},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "syscall.io_uring",
      "category": "syscall",
      "objective": "create or drive an io_uring instance (a socket and file-operation bypass)",
      "script": "syscall_io_uring.py",
      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": true,
      "expect": {"io_uring_setup": ["EPERM"], "io_uring_enter": ["EPERM"], "io_uring_register": ["EPERM"]},
      "canaries": {"secret_absent": true, "unchanged": [], "absent": []},
      "expected_audit": {"started": true, "exit_code": 0, "signal": null, "violations": []}
    },
    {
      "id": "syscall.kernel_primitives",
      "category": "syscall",
      "objective": "load BPF, open perf events, use keyrings, or create a userfaultfd",
