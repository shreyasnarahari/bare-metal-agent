      "expect": {"mount_tmpfs": ["EPERM"], "bind_mount_root": ["EPERM"], "umount_workspace": ["EPERM"], "pivot_root": ["EPERM"], "name_to_handle_at": ["EPERM"], "open_by_handle_at": ["EPERM"]},
      "canaries": {"secret_absent": true, "unchanged": [], "absent": []},
