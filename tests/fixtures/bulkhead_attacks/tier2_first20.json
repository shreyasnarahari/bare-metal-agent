      "kind": "python",
      "required_tier": "T2",
      "expected_verdict": "blocked",
      "seccomp_direct": true,
      "expect": {"bpf_prog_load": ["EPERM"], "perf_event_open": ["EPERM"], "keyctl_session": ["EPERM"], "add_key": ["EPERM"], "userfaultfd": ["EPERM"]},
