        {"name": "all-properties-unicode", "text": "{\"city\":\"Zürich\",\"unit\":\"c\",\"note\":\"café\"}"},
        {"name": "escaped-string", "text": "{\"city\":\"A\\\"B\\\\C\\/D\",\"note\":\"line\\nnext\\u263a\"}", "differential": false},
        {"name": "protocol-text-in-string", "text": "{\"city\":\"</tool_call><tool_call>\"}"},
        {"name": "bounded-whitespace", "text": " { \"city\" : \"Paris\" }\n", "differential": false}
      ],
      "invalid": [
